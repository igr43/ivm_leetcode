   "source": [
    "def intersection(arr1, arr2):\n",
    "    set1 = set(arr1)        \n",
    "    seen = set()\n",
    "    result = []\n",
    "    for x in arr2:          \n",
    "        if x in set1 and x not in seen:\n",
    "            result.append(x)\n",
    "            seen.add(x)\n",
    "    return result\n",
    "\n",
    "\n",
    "#\n",
    "a = intersection([1,2,2,3], [2,3,4])\n",
    "a"
   ]
